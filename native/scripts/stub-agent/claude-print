#!/usr/bin/env python3
# `claude -p` stand-in for the self-tests (no login, no cost). The prompt
# arrives on stdin; the reply depends on which Orbit prompt it is:
# - the Ralph PRD interview: one round of two questions, then done;
# - the PRD writer: writes the markdown PRD and scripts/ralph/prd.json;
# - a Ralph iteration (stream-json): ticks the next story, commits.
# ORBIT_STUB_LOG, when set, records each call's kind and argv.
import json, os, queue, re, subprocess, sys, threading, time, urllib.request

args = sys.argv[1:]


# Asked for "markdown", the chat reply shows every block the renderer handles.
MARKDOWN = """## Markdown reply

The entry point is native/src/main.rs:12 and the view is `native/src/chat/mod.rs:1`.

- a **bold** item
- a [link](https://example.com)

| Agent | Mode |
|-------|------|
| claude | stream-json |

```rust
fn main() {
    println!("hi");
}
```
Done."""


def show_image():
    # What Orbit's show_image MCP tool does: POST ShowImage to the session's hook route.
    icons = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..", "packaging", "icons")
    config = next((a.split("=", 1)[1] for a in args if a.startswith("--mcp-config=")), None)
    if config:
        url = json.loads(config)["mcpServers"]["orbit"]["args"][1]
        body = json.dumps({"hook_event_name": "ShowImage", "path": os.path.realpath(os.path.join(icons, "256x256.png")), "message": "The app icon"})
        urllib.request.urlopen(urllib.request.Request(url, body.encode(), {"Content-Type": "application/json"}), timeout=5).read()
    rel = os.path.relpath(os.path.join(icons, "64x64.png"))
    return f"Here it is, and a smaller one inline:\n\n![small icon]({rel})\n\nDone."


def ask_permission():
    # What Orbit's permission MCP tool does: POST PermissionRequest and wait for the user's pick.
    config = next((a.split("=", 1)[1] for a in args if a.startswith("--mcp-config=")), None)
    if not config:
        return "no hook route"
    url = json.loads(config)["mcpServers"]["orbit"]["args"][1]
    body = json.dumps({"hook_event_name": "PermissionRequest", "tool_name": "Bash", "input": {"command": "rm -rf build"}})
    return urllib.request.urlopen(urllib.request.Request(url, body.encode(), {"Content-Type": "application/json"}), timeout=660).read().decode()


def tools(out):
    # Asked for "tools": three reads and a grep (one collapsed row), an edit with a diff,
    # a long command output and a failing command, each finished after a short delay.
    cwd = os.getcwd()
    calls = [(f"r{i}", "Read", {"file_path": os.path.join(cwd, f)}, "1\tfn main() {}", False) for i, f in enumerate(["a.rs", "b.rs", "c.rs"])]
    calls.append(("g", "Grep", {"pattern": "main"}, "a.rs\nb.rs", False))
    calls.append(("e", "Edit", {"file_path": os.path.join(cwd, "a.rs"), "old_string": "fn main() {}\nlet a = 1;", "new_string": "fn main() {\n    hi();\n}\nlet a = 1;"}, "ok", False))
    calls.append(("b", "Bash", {"command": "seq 250"}, "\n".join(str(i) for i in range(1, 251)), False))
    calls.append(("x", "Bash", {"command": "false"}, "exit code 1", True))
    for id, name, input, result, err in calls:
        out({"type": "assistant", "message": {"content": [{"type": "tool_use", "id": id, "name": name, "input": input}]}})
        time.sleep(0.15)
        out({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": id, "content": result, "is_error": err}]}})


def chat():
    # Orbit's chat mode (`--input-format stream-json`): one user message per stdin line,
    # each answered with a streamed turn like the real claude's (thinking, text deltas, result).
    out = lambda v: print(json.dumps(v), flush=True)
    sid = args[args.index("--resume") + 1] if "--resume" in args else "stub-chat-session"
    # A reader thread, so an interrupt control_request lands while a turn streams.
    lines = queue.Queue()
    threading.Thread(target=lambda: [lines.put(l) for l in sys.stdin] + [lines.put(None)], daemon=True).start()
    interrupted = lambda: any(json.loads(l).get("type") == "control_request" for l in drain(lines))
    n = 0
    while (line := lines.get()) is not None:
        msg = json.loads(line)
        if msg.get("type") != "user":
            continue
        n += 1
        text = " ".join(c.get("text", "") for c in msg["message"]["content"] if c.get("type") == "text")
        out({"type": "system", "subtype": "init", "session_id": sid, "slash_commands": ["compact", "review", "init", "pr-comments", "security-review"]})
        out({"type": "stream_event", "event": {"type": "message_start", "message": {"id": f"msg-{n}"}}})
        out({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "thinking_delta", "thinking": "The user said hello."}}})
        reply = MARKDOWN if "markdown" in text else f"Stub reply to: {text}. This line streams in word by word."
        if "image" in text:
            reply = show_image()
        if "permission" in text:
            reply = f"Permission answer: {ask_permission()}."
        if "tools" in text:
            tools(out)
            reply = "Tools done."
        if "crash" in text:
            print("stub: crashed on purpose", file=sys.stderr, flush=True)
            sys.exit(3)
        # "slow" streams for a minute, until Orbit interrupts it (as claude: an error result, still alive).
        delay = 0.5 if "slow" in text else 0.02
        words = re.split(r"(?<= )", reply * (60 if "slow" in text else 1))
        stopped = False
        for word in words:
            out({"type": "stream_event", "event": {"type": "content_block_delta", "delta": {"type": "text_delta", "text": word}}})
            time.sleep(delay)
            if interrupted():
                stopped = True
                break
        if stopped:
            out({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "", "usage": {"input_tokens": 10, "output_tokens": 3}})
        else:
            out({"type": "result", "is_error": False, "result": "", "total_cost_usd": 0.001, "usage": {"input_tokens": 10, "output_tokens": 12}})


def drain(q):
    out = []
    while not q.empty():
        line = q.get()
        if line is not None:
            out.append(line)
    return out


if "--input-format" in args:
    chat()
    sys.exit(0)

prompt = sys.stdin.read()


def log(kind):
    path = os.environ.get("ORBIT_STUB_LOG")
    if path:
        with open(path, "a") as f:
            marks = [l.strip() for l in prompt.splitlines() if "MARK" in l]
            f.write(f"{kind} {json.dumps(args)}{' marks ' + json.dumps(marks) if marks else ''}\n")


def commit(msg):
    subprocess.run(["git", "add", "-A"], check=True)
    subprocess.run(["git", "-c", "user.name=stub", "-c", "user.email=stub@x", "commit", "-qm", msg], check=True)


if "Product Requirements Document for an autonomous coding loop" in prompt:
    log("interview")
    time.sleep(0.5)
    if prompt.count("- Q: ") == 0:
        print(json.dumps({"done": False, "questions": [
            {"id": "q1", "text": "Who sees the greeting?", "options": [
                {"label": "Every visitor", "description": "Simplest: one message for all.", "recommended": True},
                {"label": "Signed-in users", "description": "Needs the session."},
                {"label": "Admins only", "description": "Smallest audience."}]},
            {"id": "q2", "text": "Where does it show?", "options": [
                {"label": "Top banner", "description": "Visible, dismissible.", "recommended": True},
                {"label": "Footer", "description": "Quiet."},
                {"label": "Console", "description": "Developers only."}]}]}))
    else:
        print(json.dumps({"done": True, "questions": [],
                          "summary": "- Every visitor sees the greeting\n- It shows in a top banner"}))
elif "Write a Product Requirements Document and its Ralph task file" in prompt:
    log("write-prd")
    md = re.search(r"Markdown PRD → `([^`]+)`", prompt).group(1)
    js = re.search(r"Ralph task file → `([^`]+)`", prompt).group(1)
    branch = re.search(r'"branchName": "([^"]*)"', prompt).group(1)
    project = re.search(r'"project": "([^"]*)"', prompt).group(1)
    for line in ["Reading the repository…", "Writing " + md, "Splitting into stories…"]:
        print(line, flush=True)
        time.sleep(0.4)
    os.makedirs(os.path.dirname(md), exist_ok=True)
    os.makedirs(os.path.dirname(js), exist_ok=True)
    with open(md, "w") as f:
        f.write("# PRD: Greeting\n\n## User Stories\n\n### US-001: Add a greeting\n")
    titles = ["Add the greeting text", "Show it in a top banner", "Let visitors dismiss it"]
    stories = [{"id": f"US-00{i + 1}", "title": t, "description": f"As a visitor, I want {t.lower()}.",
                "acceptanceCriteria": ["Typecheck passes"], "priority": i + 1, "passes": False, "notes": ""}
               for i, t in enumerate(titles)]
    with open(js, "w") as f:
        json.dump({"project": project, "branchName": branch, "description": "A greeting for visitors.",
                   "userStories": stories}, f, indent=2)
    print(len(stories))
elif "stream-json" in args:
    log("iteration")
    print(json.dumps({"type": "system", "subtype": "init", "session_id": "stub", "model": "stub-model"}), flush=True)
    path = "scripts/ralph/prd.json"
    done = False
    if os.path.exists(path):
        prd = json.load(open(path))
        for s in sorted(prd["userStories"], key=lambda s: s.get("priority", 0)):
            if not s.get("passes"):
                print(json.dumps({"type": "assistant", "message": {"content": [
                    {"type": "text", "text": "Implementing **" + s["id"] + "** in `impl.txt`"},
                    {"type": "tool_use", "name": "Read", "input": {"file_path": os.path.join(os.getcwd(), path)}},
                    {"type": "tool_use", "name": "Edit", "input": {"file_path": os.path.join(os.getcwd(), "impl.txt")}},
                    {"type": "tool_use", "name": "Bash", "input": {"command": "make check"}},
                ]}}), flush=True)
                time.sleep(1.5)
                with open("impl.txt", "a") as f:
                    f.write(s["id"] + "\n")
                s["passes"] = True
                with open(path, "w") as f:
                    json.dump(prd, f, indent=2)
                commit("feat: " + s["id"])
                break
        done = all(s.get("passes") for s in prd["userStories"])
        text = "ok" + (" <promise>COMPLETE</promise>" if done else "")
    else:
        # A plan task: one commit, then the done mark.
        with open("impl.txt", "a") as f:
            f.write("task\n")
        commit("feat: plan task")
        text = "Done.\n<task-done/>"
    print(json.dumps({"type": "result", "is_error": False, "result": text,
                      "total_cost_usd": 0.01, "duration_ms": 1500, "num_turns": 2}), flush=True)
else:
    log("other")
    print("stub-claude: " + prompt[:80])
