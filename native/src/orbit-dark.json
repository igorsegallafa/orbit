{
  "name": "Orbit",
  "author": "Orbit",
  "themes": [
    {
      "name": "Orbit Dark",
      "mode": "dark",
      "font.family": "Noto Sans",
      "font.size": 13,
      "mono_font.family": "DejaVu Sans Mono",
      "mono_font.size": 13,
      "radius": 6,
      "radius.lg": 10,
      "shadow": false,
      "colors": {
        "background": "#0d0f13",
        "foreground": "#e6e8ec",
        "border": "#232833",
        "input.border": "#2e3440",
        "ring": "#4f7cf7",
        "caret": "#e6e8ec",
        "selection.background": "#4f7cf766",
        "accent.background": "#232936",
        "accent.foreground": "#e6e8ec",
        "muted.background": "#1a1e26",
        "muted.foreground": "#9aa1ad",
        "popover.background": "#1a1e26",
        "popover.foreground": "#e6e8ec",
        "primary.background": "#4f7cf7",
        "primary.hover.background": "#6d92ff",
        "primary.active.background": "#4f7cf7",
        "primary.foreground": "#ffffff",
        "secondary.background": "#1a1e26",
        "secondary.hover.background": "#232936",
        "secondary.active.background": "#2e3440",
        "secondary.foreground": "#e6e8ec",
        "danger.background": "#ff5d5d",
        "danger.foreground": "#ff5d5d",
        "success.background": "#4ade80",
        "success.foreground": "#4ade80",
        "warning.background": "#e3b341",
        "warning.foreground": "#e3b341",
        "info.background": "#7aa7ff",
        "info.foreground": "#7aa7ff",
        "link.foreground": "#7aa7ff",
        "link.hover.foreground": "#9fb8ff",
        "link.active.foreground": "#7aa7ff",
        "list.background": "#14171d",
        "list.hover.background": "#232936",
        "list.active.background": "#4f7cf726",
        "list.active.border": "#4f7cf7",
        "list.even.background": "#14171d",
        "list.head.background": "#14171d",
        "scrollbar.background": "#00000000",
        "scrollbar.thumb.background": "#2e3440e6",
        "scrollbar.thumb.hover.background": "#4a5060",
        "sidebar.background": "#14171d",
        "sidebar.border": "#232833",
        "sidebar.foreground": "#e6e8ec",
        "sidebar.accent.background": "#232936",
        "sidebar.accent.foreground": "#e6e8ec",
        "tab.background": "#00000000",
        "tab.active.background": "#0d0f13",
        "tab.active.foreground": "#e6e8ec",
        "tab.foreground": "#9aa1ad",
        "tab_bar.background": "#14171d",
        "title_bar.background": "#14171d",
        "title_bar.border": "#232833",
        "status_bar.background": "#14171d",
        "status_bar.border": "#232833",
        "window.border": "#232833",
        "overlay": "#00000066",
        "base.red": "#ff5d5d",
        "base.green": "#4ade80",
        "base.blue": "#7aa7ff",
        "base.yellow": "#e3b341",
        "base.magenta": "#c792ea",
        "base.cyan": "#7fdbca"
      },
      "highlight": {
        "editor.foreground": "#e6e8ec",
        "editor.background": "#0d0f13",
        "editor.active_line.background": "#14171d",
        "editor.line_number": "#4a5060",
        "editor.active_line_number": "#9aa1ad",
        "editor.invisible": "#6b728066",
        "conflict": "#e3b341",
        "created": "#4ade80",
        "created.background": "#4ade801f",
        "deleted": "#ff5d5d",
        "deleted.background": "#ff5d5d1f",
        "modified": "#e3b341",
        "modified.background": "#e3b3411f",
        "error.background": "#ff5d5d1f",
        "error.border": "#ff5d5d",
        "warning.background": "#e3b3411f",
        "warning.border": "#e3b341",
        "info.background": "#7aa7ff1f",
        "info.border": "#7aa7ff",
        "hint": "#9aa1ad",
        "hint.background": "#9aa1ad1f",
        "hint.border": "#6b7280",
        "success.background": "#4ade801f",
        "predictive": "#6b7280",
        "hidden": "#6b7280",
        "syntax": {
          "attribute": { "color": "#b4c5e4" },
          "boolean": { "color": "#f7b267" },
          "comment": { "color": "#6b7280", "font_style": "italic" },
          "comment.doc": { "color": "#6b7280", "font_style": "italic" },
          "constant": { "color": "#f7b267" },
          "constructor": { "color": "#82aaff" },
          "embedded": { "color": "#e6e8ec" },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "function": { "color": "#82aaff" },
          "keyword": { "color": "#c792ea" },
          "label": { "color": "#7fdbca" },
          "link_text": { "color": "#7aa7ff", "font_style": "normal" },
          "link_uri": { "color": "#7aa7ff", "font_style": "italic" },
          "namespace": { "color": "#7fdbca" },
          "number": { "color": "#f78c6c" },
          "operator": { "color": "#9aa1ad" },
          "preproc": { "color": "#c792ea" },
          "property": { "color": "#b4c5e4" },
          "punctuation": { "color": "#9aa1ad" },
          "string": { "color": "#a5d6a7" },
          "string.escape": { "color": "#7fdbca" },
          "string.regex": { "color": "#7fdbca" },
          "string.special": { "color": "#a5d6a7" },
          "tag": { "color": "#7aa7ff" },
          "text.literal": { "color": "#a5d6a7" },
          "title": { "color": "#f7b267", "font_weight": 600 },
          "type": { "color": "#7aa7ff" },
          "variable": { "color": "#e6e8ec" },
          "variable.parameter": { "color": "#e6c07b" },
          "variable.special": { "color": "#f7b267" }
        }
      }
    }
  ]
}
